# Neon PostgreSQL. DATABASE_URL must be the pooled (-pooler) connection string, used by the
# app's own PrismaClient at runtime. DIRECT_URL must be the direct (non-pooled) connection,
# used only by the Prisma CLI for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Google Gemini
GOOGLE_API_KEY=""
# Optional; defaults to "gemini-flash-latest" if unset.
GEMINI_MODEL=""

# Tavily web search
TAVILY_API_KEY=""

# Required only in production (NODE_ENV=production), to protect POST /api/memories/backfill.
# Set to a long random value, then pass it as the x-maintenance-secret header when calling
# that endpoint. Leave unset in development.
MAINTENANCE_SECRET=""
